#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/

# Кэш скрипта-генератора городов (tool/generate_cities.py)
tool/.cache/
.pub/
/build/
*.g.dart
*.freezed.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configuration — contains API keys; do not commit.
# Каждое правило игнорирует конкретный путь файла Firebase-конфигурации.
# Если добавляете новый flavor — впишите его google-services.json сюда.
/android/app/google-services.json
/android/app/src/*/google-services.json
/google-services-dev.json
/android/key.properties
ios/Runner/GoogleService-Info.plist
/GoogleService-Info.plist
google-services.json

# Release signing — keystore и пароли к нему не коммитим.
/android/key.properties
*.jks
*.keystore

# AI agent generated state and system skills.
.impeccable/
.zcode/
docs/superpowers/
.agents/skills/impeccable/
.agents/skills/ponytail/

# Local SDK installs
.flutter_sdk/
.jdk/
.android_sdk/
.android_avd/

# FVM — версия Flutter фиксируется в .fvmrc, сам симлинк не коммитим.
.fvm/flutter_sdk
.fvm/version
